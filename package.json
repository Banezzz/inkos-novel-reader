{
  "name": "inkos-novel-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Password-protected multi-book Chinese novel reader & InkOS real-time cloud bookshelf on Cloudflare Workers + D1 (100% Free Tier)",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8788",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-books.mjs",
    "sync:watch": "node scripts/sync-books.mjs --watch"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^4.152.0"
  }
}
